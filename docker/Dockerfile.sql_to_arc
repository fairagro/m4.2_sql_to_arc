# syntax=docker/dockerfile:1.4
# Product-local last stage for sql_to_arc (NOT synced). Bake wires context
# `export_bins` → shared base `export-binaries` (see docker-bake.hcl).
#
# Microsoft ODBC driver apk is product-only (docs/ci.md) — stay here, not in
# synced docker/Dockerfile.product-app.base.
# Pins: ALPINE_VERSION from versions.env (no literal pin here).

ARG ALPINE_VERSION
FROM alpine:${ALPINE_VERSION}

ARG RUNTIME_USER=sql_to_arc
# Pinned runtime apk versions (product last-stage personality).
ARG UNIXODBC_VERSION=2.3.14-r1
ARG LIBSTDCXX_VERSION=15.2.0-r5
ARG GCOMPAT_VERSION=1.1.0-r4
ARG ZLIB_VERSION=1.3.2-r0
ARG MSODBCSQL_APK=msodbcsql18_18.6.1.1-1_amd64.apk
ARG MSODBCSQL_URL=https://download.microsoft.com/download/9dcab408-e0d4-4571-a81a-5a0951e3445f/msodbcsql18_18.6.1.1-1_amd64.apk
# Integrity pin for the Microsoft APK (not signed for Alpine's apk keys).
ARG MSODBCSQL_SHA256=2c7ef3db6afe2be6fe45e744b116a41d2619187398b2b199bd0ee62c1e0b2924

WORKDIR /middleware

# hadolint ignore=DL3018
RUN apk add --no-cache --upgrade \
        "unixodbc=${UNIXODBC_VERSION}" \
        "libstdc++=${LIBSTDCXX_VERSION}" \
        "gcompat=${GCOMPAT_VERSION}" \
        "zlib=${ZLIB_VERSION}" \
        curl && \
    curl -L -o "/tmp/${MSODBCSQL_APK}" "${MSODBCSQL_URL}" && \
    printf '%s  %s\n' "${MSODBCSQL_SHA256}" "/tmp/${MSODBCSQL_APK}" > /tmp/msodbc.sha256 && \
    sha256sum -c /tmp/msodbc.sha256 && \
    rm -f /tmp/msodbc.sha256 && \
    apk add --no-cache --allow-untrusted "/tmp/${MSODBCSQL_APK}" && \
    rm -f "/tmp/${MSODBCSQL_APK}" && \
    apk del curl && \
    addgroup -S "${RUNTIME_USER}" && \
    adduser -S -H -G "${RUNTIME_USER}" "${RUNTIME_USER}" && \
    chown "${RUNTIME_USER}:${RUNTIME_USER}" /middleware

# Primary onedir from shared product-app.base export-binaries
# hadolint ignore=DL3022
COPY --chown=${RUNTIME_USER}:${RUNTIME_USER} --from=export_bins /dist/sql_to_arc /middleware/sql_to_arc

USER ${RUNTIME_USER}

CMD ["/middleware/sql_to_arc/sql_to_arc", "-c", "/etc/sql_to_arc/config.yaml"]
