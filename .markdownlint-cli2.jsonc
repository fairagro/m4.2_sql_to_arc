{
  // Single source of truth for VS Code (davidanson.vscode-markdownlint) and CLI
  // (markdownlint-cli2). Both use the same engine.
  // OpenSpec tool files are regenerated by `openspec init` / `openspec update`
  // and must not be hand-edited to satisfy markdownlint.
  "gitignore": true,
  "globs": [
    "**/*.md",
    "**/*.mdc"
  ],
  "ignores": [
    ".cursor/commands/**",
    ".cursor/skills/openspec-*/**",
    ".github/prompts/opsx-*.prompt.md",
    ".github/skills/openspec-*/**",
    "dev_environment/demo_output/**"
  ],
  "config": {
    "default": true,
    // Prose, table cells, and OpenSpec requirement text routinely exceed fixed widths.
    "MD013": false,
    // OpenSpec change artifacts intentionally start at ## (delta / proposal templates).
    "MD041": false
  }
}
